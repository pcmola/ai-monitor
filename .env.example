# Copy this file to .env and fill in real values locally.
# Never commit .env or real credentials.
# All tools read this single .env at the project root.

# Local monitor hub addresses (informational; hosts file controls routing)
# Hub: http://ai-monitor.local
# Usage monitor: http://usage-monitor.local
# Cost monitor: http://cost-monitor.local
# Direct fallback: http://127.0.0.1:8770 / :8767 / :8769

# Azure DevOps (wiki_tools/wiki_documents.py, proxy_tools/squid_policy_publish.py)
# PAT scopes: Wiki (Read & write), Work Items (Read & write), Code (Read & write)
AZURE_DEVOPS_ORG=your-azure-devops-org
AZURE_DEVOPS_PROJECT="Your Project"
AZURE_DEVOPS_WIKI=YourProject.wiki
AZURE_DEVOPS_PAT=replace-with-azure-devops-pat

# Azure OpenAI-compatible gateway (wiki_tools/wiki_search.py)
# Keep the real hostname and key only in .env, never in this example file.
AZURE_OPENAI_ENDPOINT=https://your-gateway.example.com
AZURE_OPENAI_API_KEY=replace-with-api-key
OPENAI_API_VERSION=2024-12-01-preview
OPENAI_MODEL=your-chat-model
OPENAI_EMBED_MODEL=text-embedding-3-large
# Weight of embedding similarity in hybrid search.
EMBED_WEIGHT=8
# Leave empty to follow the hosts file (for example, http://wiki.local).
WIKI_VIEWER_URL=

# Web search for wiki_tools/wiki_search.py (optional, https://tavily.com)
TAVILY_API_KEY=
WEB_SEARCH_MIN_SIM=0.5
WEB_SEARCH_MAX=5

# Optional providers for wiki_tools/wiki_search.py
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=your-anthropic-model

# Squid proxy VM access
SQUID_HOST=replace-with-proxy-public-ip
PROXY_ALLOWED_CLIENTS=203.0.113.10/32
SQUID_SSH_USER=azureuser
# Leave empty to use the default SSH key (~/.ssh/id_rsa).
SQUID_SSH_KEY=
SQUID_POLICY_ROOT=/etc/squid
SQUID_CONTAINER=squid
SQUID_RUNTIME=podman
SQUID_POLICY_WRAPPER=
SQUID_POLICY_SNAPSHOT=

# Microsoft Teams (requires a work/school Microsoft 365 account)
TEAMS_WEBHOOK_URL=
TEAMS_CLIENT_ID=
TEAMS_TENANT_ID=
