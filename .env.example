# 실제 .env와 같은 설정 항목이며, 아래 값은 공개용 예시입니다.
# 필요하면 이 파일을 .env로 복사하고 실제 값은 로컬에서만 입력하세요.
# .env나 실제 인증정보는 Git에 올리지 마세요.

# Azure DevOps 연결 설정
AZURE_DEVOPS_ORG=your-azure-devops-org
AZURE_DEVOPS_PROJECT="Your Project"
AZURE_DEVOPS_WIKI=YourProject.wiki
AZURE_DEVOPS_PAT=replace-with-azure-devops-pat

# 사내 Azure OpenAI 게이트웨이 (wiki_search 가이드 작성 + 임베딩)
# 실제 엔드포인트 주소와 API 키는 .env에만 보관하세요.
AZURE_OPENAI_ENDPOINT=https://your-gateway.example.com
AZURE_OPENAI_API_KEY=replace-with-api-key
OPENAI_API_VERSION=replace-with-api-version
OPENAI_MODEL=your-chat-model
OPENAI_EMBED_MODEL=your-embedding-model
